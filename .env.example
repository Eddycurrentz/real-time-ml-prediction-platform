# Copy to .env and replace both values with unique, random URL-safe secrets.
# Use at least 32 characters for each value; do not commit .env.
POSTGRES_PASSWORD=
RTML_API_KEY=

# Optional host bindings. Keep these on loopback unless a protected reverse proxy
# with TLS and rate limiting is configured in front of the API.
API_BIND_ADDRESS=127.0.0.1
DATABASE_BIND_ADDRESS=127.0.0.1
KAFKA_BIND_ADDRESS=127.0.0.1
